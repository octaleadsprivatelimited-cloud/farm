{
  "name": "kaushik-nursery",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kaushik Nursery Node.js and MySQL marketplace",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "worker": "node server/worker-entry.js",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "node --test --test-timeout=30000 --test-concurrency=1 tests/*.test.js",
    "test:load": "node load-tests/smoke.mjs",
    "format": "prettier --write server scripts tests load-tests public/app.js public/api.js public/live-controller.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.3",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
