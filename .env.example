# Copy to .env for local work; use hPanel/server secrets for deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=kaushik
DB_USER=kaushik
DB_PASSWORD=replace-with-a-strong-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
# DB_SSL_CA=/run/secrets/mysql-ca.pem
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_NAMESPACE=nursery
SESSION_SECRET=replace-with-at-least-48-random-characters-not-a-human-password
SESSION_DAYS=7
# Exact trusted load-balancer IPs/CIDRs. Never trust arbitrary internet proxies.
TRUST_PROXY=
MIGRATE_ON_START=false
SEED_CATALOG_ON_START=false
RUN_WORKER=true
# disabled | razorpay | test (test is rejected in production)
PAYMENT_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# disabled | twilio
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Password reset mail
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=nursery@example.com
# local for development only; production requires private S3-compatible storage
STORAGE_DRIVER=local
UPLOAD_DIRECTORY=./var/uploads
# S3_ENDPOINT=https://objects.example.com
# Use the actual AWS region for Amazon S3; auto is for compatible custom endpoints.
S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# METRICS_TOKEN=replace-with-at-least-32-random-characters
LOG_LEVEL=info
# Optional FCM HTTP v1 push for Android/web clients. Keep the JSON key outside source.
PUSH_PROVIDER=disabled
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
