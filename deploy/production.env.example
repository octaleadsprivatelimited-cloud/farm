# Domain-specific template only. Supply values through server secrets before starting.
# Keep this outside Git once populated; never use local development credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://www.kaushiknursery.in
DB_HOST=REPLACE_WITH_PRIVATE_MYSQL_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_PRODUCTION_DATABASE
DB_USER=REPLACE_WITH_PRODUCTION_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_DATABASE_PASSWORD
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
REDIS_URL=rediss://REPLACE_WITH_PRIVATE_REDIS_ENDPOINT:6379/0
REDIS_NAMESPACE=kaushiknursery
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_GENERATED_FOR_PRODUCTION
SESSION_DAYS=7
METRICS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Exact trusted load-balancer IPs/CIDRs after those resources are provisioned.
TRUST_PROXY=REPLACE_WITH_TRUSTED_PROXY_IPS
MIGRATE_ON_START=false
SEED_CATALOG_ON_START=false
RUN_WORKER=false
PAYMENT_MODE=disabled
SMS_PROVIDER=disabled
PUSH_PROVIDER=disabled
STORAGE_DRIVER=s3
S3_ENDPOINT=https://REPLACE_WITH_PRIVATE_OBJECT_STORAGE_ENDPOINT
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
LOG_LEVEL=info
# Enable Razorpay, Twilio, SMTP and FCM after credentials and sandbox acceptance.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# DB_SSL_CA=/run/secrets/mysql-ca.pem
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
