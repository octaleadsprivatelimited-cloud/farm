# Domain supplied by the user. Keep the currently public www canonical URL.
# Set NURSERY_API_UPSTREAMS to the provisioned private API address(es), separated by spaces.
# No VPS address has been selected. Do not apply DNS changes until the APIs are ready.
kaushiknursery.in {
    redir https://www.kaushiknursery.in{uri} permanent
}
www.kaushiknursery.in {
    encode zstd gzip
    request_body {
        max_size 1MB
    }
    @public path /assets/* /styles.css /storefront.css
    header @public Cache-Control "public, max-age=86400"
    @api path /api/*
    header @api Cache-Control "no-store"
    reverse_proxy {$NURSERY_API_UPSTREAMS} {
        lb_policy least_conn
        health_uri /health/ready
        health_interval 10s
        health_timeout 3s
        fail_duration 15s
        lb_try_duration 5s
        lb_retry_match {
            method GET HEAD OPTIONS
        }
        transport http {
            dial_timeout 3s
            response_header_timeout 15s
            keepalive 30s
        }
    }
    log {
        output file /var/log/caddy/kaushiknursery.log {
            roll_size 20MiB
            roll_keep 5
        }
    }
}
